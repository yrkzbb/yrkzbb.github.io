<%
page.layout = "links"
page.title = theme.links.title || __('links.title')
page.subtitle = theme.links.subtitle || __('links.subtitle')
page.banner_img = theme.links.banner_img
page.banner_img_height = theme.links.banner_img_height
page.banner_mask_alpha = theme.links.banner_mask_alpha
page.comment = theme.links.comments.type
%>

<section class="connect-page">
  <div class="connect-section-heading">
    <div><small>MY CORNERS</small><h2>我的网络坐标</h2></div>
    <span>保持联系</span>
  </div>
  <div class="connect-grid connect-own-grid">
    <a class="connect-card github" href="https://github.com/yrkzbb" target="_blank" rel="noopener">
      <i class="iconfont icon-github-fill" aria-hidden="true"></i>
      <div><strong>GitHub</strong><p>代码、项目与持续构建的痕迹</p></div><span>访问 ↗</span>
    </a>
    <a class="connect-card bilibili" href="https://space.bilibili.com/640076864" target="_blank" rel="noopener">
      <i class="iconfont icon-bilibili-fill" aria-hidden="true"></i>
      <div><strong>Bilibili</strong><p>视频、收藏与屏幕之外的兴趣</p></div><span>访问 ↗</span>
    </a>
  </div>

  <% var neighbors = (theme.links.items || []).filter(function(item){ return item.title && item.link }) %>
  <% if (neighbors.length) { %>
    <div class="connect-section-heading neighbor-heading">
      <div><small>WEB NEIGHBORS</small><h2>网络邻居</h2></div>
      <span><%= neighbors.length %> 个站点</span>
    </div>
    <div class="connect-grid neighbor-grid">
      <% neighbors.forEach(function(each) { %>
        <a class="connect-card neighbor" href="<%= url_for(each.link) %>" target="_blank" rel="noopener">
          <img src="<%= url_for(each.avatar || each.image || theme.links.onerror_avatar) %>" alt="" onerror="this.onerror=null;this.src='<%= url_for(theme.links.onerror_avatar) %>'">
          <div><strong><%= each.title %></strong><p><%= each.intro || '去看看这个独立站点' %></p></div><span>拜访 ↗</span>
        </a>
      <% }) %>
    </div>
  <% } %>

</section>

<% if(theme.links.custom && theme.links.custom.enable && theme.links.custom.content) { %>
  <!-- Custom -->
  <div class="custom mx-auto">
    <%- theme.links.custom.content %>
  </div>
<% } %>

<%- inject_point('linksComments') %>
