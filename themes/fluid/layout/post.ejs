<%
page.banner_img = page.banner_img || theme.post.banner_img
page.banner_img_height = page.banner_img_height || theme.post.banner_img_height
page.banner_mask_alpha = page.banner_mask_alpha || theme.post.banner_mask_alpha
var postSeries = knowledge_series(page)
var overallPostTotal = site.posts.length
var overallRouteProgress = postSeries ? Math.round(((postSeries.index + 1) / overallPostTotal) * 100) : 0
%>

<meta name="hexo-source" content="<%= page.source || '' %>">
<link rel="stylesheet" href="<%- url_for('/css/admin-entry.css') %>">
<link rel="stylesheet" href="<%- url_for('/css/inline-editor.css') %>">

<div class="container-fluid nopadding-x">
  <div class="row nomargin-x">
    <div class="side-col post-left-col d-none d-lg-block col-lg-2">
      <% if (postSeries) { %>
        <aside class="series-rail" aria-label="<%= postSeries.name %> 系列学习导航">
          <div class="series-rail-heading">
            <a href="#series-title"><%= postSeries.name %> 学习路线</a>
            <span><%= postSeries.index + 1 %> / <%= overallPostTotal %></span>
          </div>
          <div class="series-progress" role="progressbar" aria-label="全站文章学习位置" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= overallRouteProgress %>">
            <span style="width:<%= overallRouteProgress %>%"></span>
          </div>
          <nav aria-label="<%= postSeries.name %> 系列目录">
            <% postSeries.items.forEach(function(item, itemIndex) { %>
              <a class="<%= itemIndex === postSeries.index ? 'current' : itemIndex < postSeries.index ? 'passed' : 'upcoming' %>" href="<%= itemIndex === postSeries.index ? '#seo-header' : url_for(item.path) %>" <%- itemIndex === postSeries.index ? 'aria-current="page"' : '' %>>
                <small><%= String(itemIndex + 1).padStart(2, '0') %></small>
                <strong><%= item.title %></strong>
              </a>
            <% }) %>
          </nav>
          <p class="series-rail-hint">当前位于第 <%= postSeries.index + 1 %> 篇，后面还有 <%= postSeries.items.length - postSeries.index - 1 %> 篇</p>
          <div class="series-rail-extra">
            <div class="series-rail-section rail-review">
              <div class="series-rail-section-head"><p>快速回顾</p><button type="button" data-edit-review>编辑</button></div>
              <ul data-quick-review></ul>
            </div>
            <div class="series-rail-section rail-terms" hidden>
              <p>本文术语</p>
              <div data-article-terms></div>
            </div>
            <label class="series-mastery">本篇掌握度
              <select data-mastery aria-label="本篇掌握度">
                <option value="unread">未读</option>
                <option value="learning">在学</option>
                <option value="mastered">已掌握</option>
              </select>
            </label>
            <div class="series-rail-actions">
              <button type="button" data-random-post>随机一篇</button>
            </div>
            <span class="series-rail-feedback" aria-live="polite"></span>
          </div>
        </aside>
      <% } %>
      <%- inject_point('postLeft') %>
    </div>

    <div class="post-main-col col-lg-8 nopadding-x-md">
      <div class="container nopadding-x-md" id="board-ctn">
        <div id="board">
          <article class="post-content mx-auto">
            <h1 id="seo-header"><%= page.subtitle || page.title %></h1>
            <% if (theme.post.updated.enable && theme.post.updated && compare_date(page.date, page.updated)) { %>
              <p id="updated-time" class="note note-<%= theme.post.updated.note_class || 'info' %>" style="<%= theme.post.updated.relative ? 'display: none' : '' %>">
                <% if (theme.post.updated.relative) { %>
                  <% if (theme.post.updated.content) { %>
                    <!-- compatible with older versions-->
                    <%- theme.post.updated.content %><%- date(page.updated, 'YYYY-MM-DDTHH:mm:ssZ') %>
                  <% } else { %>
                    <%- __('post.updated', date(page.updated, 'YYYY-MM-DDTHH:mm:ssZ')) %>
                  <% } %>
                  <%- partial('_partials/plugins/moment.ejs') %>
                <% } else { %>
                  <% if (theme.post.updated.content) { %>
                    <!-- compatible with older versions-->
                    <%- theme.post.updated.content %><%- date(page.updated, theme.post.updated.date_format) %>
                  <% } else { %>
                    <%- __('post.updated', date(page.updated, theme.post.updated.date_format)) %>
                  <% } %>
                <% } %>
              </p>
            <% } %>
            <% if (page.encrypt === true) { %>
              <%- inject_point('postMarkdownBegin') %>
              <%- page.content %>
              <%- partial('_partials/plugins/encrypt') %>
              <%- inject_point('postMarkdownEnd') %>
            <% } else { %>
              <div class="markdown-body">
                <%- inject_point('postMarkdownBegin') %>
                <%- page.content %>
                <%- inject_point('postMarkdownEnd') %>
              </div>
            <% } %>

            <% var series = postSeries %>
            <% if (series) { %>
              <section class="knowledge-series" aria-labelledby="series-title">
                <div class="series-heading">
                  <div><small>学习路线</small><h2 id="series-title"><%= series.name %> 系列</h2></div>
                  <strong><%= series.index + 1 %> / <%= series.items.length %></strong>
                </div>
                <div class="series-progress" role="progressbar" aria-label="<%= series.name %> 系列学习进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= series.progress %>"><span style="width:<%= series.progress %>%"></span></div>
                <ol>
                  <% series.items.forEach(function(item, index) { %>
                    <li class="<%= index === series.index ? 'current' : index < series.index ? 'completed' : '' %>">
                      <a href="<%= url_for(item.path) %>" <%- index === series.index ? 'aria-current="page"' : '' %>><span><%= index + 1 %></span><%= item.title %></a>
                    </li>
                  <% }) %>
                </ol>
              </section>
            <% } %>

            <% var related = related_posts(page, 5) %>
            <% if (related.length) { %>
              <section class="related-posts" aria-labelledby="related-title">
                <h2 id="related-title">继续探索</h2>
                <div class="related-post-grid">
                  <% related.forEach(function(item) { %>
                    <a href="<%= url_for(item.path) %>"><strong><%= item.title %></strong><small><%= item.categories.toArray().map(function(category){ return category.name }).join(' · ') %></small></a>
                  <% }) %>
                </div>
                <div class="discovery-actions"><button type="button" data-continue-reading>继续上次阅读</button><button type="button" data-random-post>随机文章</button></div>
              </section>
            <% } %>

            <% var changes = post_changelog(page, 4) %>
            <% if (changes.length) { %>
              <details class="post-changelog">
                <summary>文章更新记录（<%= changes.length %>）</summary>
                <ol>
                  <% changes.forEach(function(change) { %><li><time><%= change.date %></time><span><%= change.message %></span></li><% }) %>
                </ol>
              </details>
            <% } %>
            <hr/>
            <div>
              <%- inject_point('postMetaBottom') %>

              <%- inject_point('postCopyright') %>

              <% if (theme.post.prev_next.enable && !page.hide) { %>
                <div class="post-prevnext my-3">
                  <article class="post-prev col-6">
                    <% const prev = prev_post(page) %>
                    <% if (prev) { %>
                      <a href="<%= url_for(prev.path) %>" title="<%= prev.title %>">
                        <i class="iconfont icon-arrowleft"></i>
                        <span class="hidden-mobile"><%= prev.title %></span>
                        <span class="visible-mobile"><%- __('post.prev_post') %></span>
                      </a>
                    <% } %>
                  </article>
                  <article class="post-next col-6">
                    <% const next = next_post(page) %>
                    <% if (next) { %>
                      <a href="<%= url_for(next.path) %>" title="<%= next.title %>">
                        <span class="hidden-mobile"><%= next.title %></span>
                        <span class="visible-mobile"><%- __('post.next_post') %></span>
                        <i class="iconfont icon-arrowright"></i>
                      </a>
                    <% } %>
                  </article>
                </div>
              <% } %>
            </div>

            <%- inject_point('postComments') %>
          </article>
        </div>
      </div>
    </div>

    <div class="side-col post-right-col d-none d-lg-block col-lg-2">
      <%- inject_point('postRight') %>
    </div>
  </div>
</div>

<%- partial('_partials/markdown-plugins') %>

<% if(theme.post.custom && theme.post.custom.enable && theme.post.custom.content && page.custom !== false) { %>
  <!-- Custom -->
  <div class="col-lg-7 mx-auto nopadding-x-md">
    <div class="container custom post-custom mx-auto">
      <%- page.custom || theme.post.custom.content %>
    </div>
  </div>
<% } %>

<script defer src="<%- url_for('/js/post-editor-link.js') %>"></script>
