{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "hexo generate",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "new": "hexo new",
    "publish": "hexo clean && hexo generate && hexo deploy",
    "server": "hexo server",
    "admin": "HEXO_ADMIN=true hexo clean && HEXO_ADMIN=true hexo server",
    "check:links": "node tools/check-links.js",
    "audit": "node tools/audit-site.js",
    "optimize:images": "node tools/optimize-images.js",
    "test": "node scripts/validate-content.js && node tools/check-links.js --source && node --check scripts/knowledge-features.js && node --check source/admin/admin.js && node --check source/js/post-editor-link.js && node --check source/js/reading-enhancements.js && node --check source/js/knowledge-ui.js && node --check source/js/duration.js",
    "verify": "npm test && npm run build && npm run check:links && npm run audit",
    "lighthouse": "node tools/run-lighthouse.js",
    "format": "prettier --write source/js source/admin scripts"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "@traptitech/markdown-it-katex": "^3.6.0",
    "hexo": "^7.3.0",
    "hexo-abbrlink": "^2.2.1",
    "hexo-deployer-git": "^4.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-seo-friendly-sitemap": "^0.2.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-helper-live2d": "^3.1.1",
    "hexo-math": "^5.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-markdown-it": "^7.1.1",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-fluid": "^1.9.8",
    "hexo-theme-landscape": "^1.0.0",
    "live2d-widget-model-wanko": "^1.0.5",
    "oh-my-live2d": "^0.19.3",
    "turndown": "7.2.0",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "prettier": "3.6.2"
  }
}
