.inline-editing
  min-height 280px
  padding 18px 20px !important
  margin-left -20px
  margin-right -20px
  border 2px solid rgba(78, 110, 242, .35)
  border-radius 12px
  outline none
  background rgba(255, 255, 255, .92)
  box-shadow 0 0 0 5px rgba(78, 110, 242, .07)
  caret-color #4e6ef2

.inline-edit-toolbar
  position fixed
  z-index 1100
  left 50%
  bottom 26px
  transform translateX(-50%)
  min-width 360px
  padding 10px 12px 10px 16px
  display flex
  align-items center
  justify-content space-between
  gap 24px
  color #fff
  background rgba(23, 32, 51, .94)
  border 1px solid rgba(255, 255, 255, .12)
  border-radius 14px
  box-shadow 0 16px 42px rgba(15, 22, 38, .32)
  backdrop-filter blur(14px)

.inline-edit-status
  display flex
  align-items center
  gap 8px
  font-size 14px

.inline-edit-dot
  width 8px
  height 8px
  border-radius 50%
  background #5ee1a2
  box-shadow 0 0 0 4px rgba(94, 225, 162, .15)

.inline-edit-toolbar button
  padding 9px 13px
  border 0
  border-radius 8px
  color #dce2ef
  background transparent
  cursor pointer

.inline-edit-toolbar .save
  margin-left 4px
  color #fff
  background linear-gradient(135deg, #4e6ef2, #7557e8)
  font-weight 700

.inline-edit-toolbar button:disabled
  opacity .6
  cursor wait

.inline-edit-toast
  position fixed
  z-index 1200
  left 50%
  top 22px
  transform translate(-50%, -80px)
  padding 11px 18px
  border-radius 10px
  color #fff
  background #172033
  box-shadow 0 14px 35px rgba(20, 28, 48, .25)
  opacity 0
  transition all .25s ease

.inline-edit-toast.show
  transform translate(-50%, 0)
  opacity 1

.inline-edit-toast.error
  background #c93f4d

@media (max-width: 576px)
  .inline-edit-toolbar
    min-width 0
    width calc(100% - 24px)
    bottom 12px

  .inline-editing
    margin-left -8px
    margin-right -8px
    padding 12px 8px !important
