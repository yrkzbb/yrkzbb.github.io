.blog-edit-link
  display block
  margin 0 0 12px auto
  padding 7px 14px
  border 1px solid rgba(79, 110, 242, .28)
  border-radius 15px
  color #4e6ef2
  font-size 13px
  font-weight 500
  vertical-align middle
  text-decoration none
  transition all .2s ease

.blog-edit-link:hover
  color #fff
  background #4e6ef2
  text-decoration none
