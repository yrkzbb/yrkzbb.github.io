// 分类页
.category {
  .row {
    border-radius: 1rem;
  }

  .category-item {
    border-radius: 1rem;
  }

  .category-post-list {
    border-radius: 1rem;
  }
}

// 归档页
.list-group {
  border-radius: 1rem;
}

// 分类和归档页共同
.list-group-item {
  border-radius: 1rem;
}

// 友链页
.links .card-body {
  border-radius: 1rem;
}

// 连接页：个人网络坐标与独立站点邻居
.connect-page {
  max-width: 980px;
  margin: 0 auto;
  padding: 0.6rem 0 1.5rem;
}

.connect-section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 2rem 0 0.85rem;

  small { color: #6d5ce7; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.12em; }
  h2 { margin: 0.15rem 0 0; font-size: 1.25rem; }
  > span { color: var(--sec-text-color); font-size: 0.78rem; }
}

.connect-page > .connect-section-heading:first-child { margin-top: 0; }

.connect-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.85rem;
}

.connect-card {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 0.9rem;
  min-width: 0;
  padding: 1.15rem;
  border: 1px solid rgba(127, 127, 127, 0.14);
  border-radius: 1rem;
  color: var(--text-color);
  background: var(--board-bg-color);
  box-shadow: 0 10px 26px rgba(31, 45, 61, 0.06);
  transition: transform 0.2s ease, box-shadow 0.2s ease;

  &:hover { color: var(--text-color); transform: translateY(-3px); box-shadow: 0 14px 32px rgba(31, 45, 61, 0.11); }
  > i { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 0.85rem; color: #fff; font-size: 1.55rem; }
  &.github > i { background: linear-gradient(135deg, #24292f, #57606a); }
  &.bilibili > i { background: linear-gradient(135deg, #fb7299, #ec4899); }
  > img { width: 3rem; height: 3rem; border-radius: 50%; object-fit: cover; }
  strong { display: block; }
  p { margin: 0.18rem 0 0; color: var(--sec-text-color); font-size: 0.82rem; }
  > span { color: #6d5ce7; font-size: 0.75rem; white-space: nowrap; }
}

// 菜单栏
.navbar {
  .nav-item .nav-link {
    border-radius: 0.5rem;
  }

  .dropdown-menu {
    border-radius: 0.5rem;
  }

  .dropdown-item {
    border-radius: 0.25rem;
  }
}

// 页面背景板
#board {
  border-radius: 1rem;
}

// 返回顶部按钮
#scroll-top-button {
  border-radius: 0.5rem;
}

// 文章目录长标题自动换行，避免省略号截断
#toc .toc-list-item {
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
  overflow-wrap: anywhere;
  word-break: break-word;
}

#toc .tocbot-link {
  display: block;
  padding-top: 0.12rem;
  padding-bottom: 0.12rem;
  line-height: 1.45;
}

// 阅读进度、剩余时间和文章分享
.reading-progress {
  position: fixed;
  z-index: 1040;
  top: 0;
  left: 0;
  width: 100%;
  height: 3px;
  pointer-events: none;

  > span {
    display: block;
    width: 0;
    height: 100%;
    background: linear-gradient(90deg, #20d9d2, #2f80ed, #8b5cf6, #ec4899, #ff8a3d, #20d9d2);
    background-size: 240% 100%;
    box-shadow: 0 0 6px rgba(47, 128, 237, 0.65), 0 0 12px rgba(236, 72, 153, 0.3);
    animation: reading-progress-colors 5s linear infinite;
    transition: width 80ms linear;
  }
}

@keyframes reading-progress-colors {
  from {
    background-position: 0 0;
  }

  to {
    background-position: 240% 0;
  }
}

.reading-indicator {
  position: fixed;
  z-index: 1030;
  right: 1rem;
  bottom: 4.8rem;
  padding: 0.3rem 0.65rem;
  border-radius: 999px;
  color: #fff;
  background: rgba(32, 35, 42, 0.78);
  font-size: 0.75rem;
  opacity: 0;
  transform: translateY(6px);
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.2s ease;
  backdrop-filter: blur(8px);

  &.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
}

.article-share-button {
  position: fixed;
  z-index: 1030;
  right: 1rem;
  bottom: 7.25rem;
  width: 2.5rem;
  height: 2.5rem;
  padding: 0;
  border: 0;
  border-radius: 0.65rem;
  color: #fff;
  background: rgba(32, 35, 42, 0.78);
  font-size: 1.25rem;
  line-height: 2.5rem;
  cursor: pointer;
  backdrop-filter: blur(8px);
  transition: transform 0.18s ease, background 0.18s ease;

  &:hover,
  &:focus-visible {
    background: #29d;
    transform: translateY(-2px);
    outline: none;
  }
}

@media (max-width: 575.98px) {
  .reading-indicator {
    right: 0.65rem;
    bottom: 4.5rem;
  }

  .article-share-button {
    right: 0.65rem;
    bottom: 7rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .reading-progress > span,
  .reading-indicator,
  .article-share-button {
    animation: none;
    transition: none;
  }
}

// 搜索键盘选择状态
#local-search-result .search-result-active {
  color: #fff;
  background: #29d;
  border-color: #29d;
}

.search-result-status {
  margin: 0.75rem 0;
  color: var(--sec-text-color);
  text-align: center;
  font-size: 0.85rem;
}

// 键盘用户可直接跳过导航
.skip-to-content {
  position: fixed;
  z-index: 2000;
  top: 0.5rem;
  left: 0.5rem;
  padding: 0.55rem 0.85rem;
  border-radius: 0.5rem;
  color: #fff;
  background: #1677b3;
  transform: translateY(-150%);

  &:focus {
    color: #fff;
    transform: translateY(0);
  }
}

// 代码块在长行和移动设备上的阅读控制
.markdown-body pre {
  position: relative;
}

.markdown-body pre.code-wrap-enabled code {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.code-wrap-button {
  position: absolute;
  top: 0.35rem;
  right: 2.7rem;
  z-index: 2;
  padding: 0.15rem 0.45rem;
  border: 0;
  border-radius: 0.3rem;
  color: inherit;
  background: rgba(127, 127, 127, 0.2);
  font-size: 0.7rem;
  cursor: pointer;
}

// 移动端悬浮文章目录
.mobile-toc-button,
.mobile-toc-panel {
  display: none;
}

@media (max-width: 991.98px) {
  .mobile-toc-button {
    display: block;
    position: fixed;
    z-index: 1030;
    left: 0.65rem;
    bottom: 1rem;
    width: 2.65rem;
    height: 2.65rem;
    padding: 0;
    border: 0;
    border-radius: 0.65rem;
    color: #fff;
    background: rgba(32, 35, 42, 0.82);
    font-size: 1.2rem;
    cursor: pointer;
    backdrop-filter: blur(8px);
  }

  .mobile-toc-button[hidden] {
    display: none;
  }

  .mobile-toc-panel {
    display: flex;
    position: fixed;
    z-index: 1050;
    inset: 0;
    align-items: flex-end;
    padding: 1rem;
    background: rgba(0, 0, 0, 0.42);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .mobile-toc-panel.is-open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-toc-card {
    width: 100%;
    max-height: min(70vh, 36rem);
    padding: 1rem;
    border-radius: 1rem;
    background: var(--board-bg-color, #fff);
    box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.2);
    overflow: hidden;
    transform: translateY(1rem);
    transition: transform 0.2s ease;
  }

  .mobile-toc-panel.is-open .mobile-toc-card {
    transform: translateY(0);
  }

  .mobile-toc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;

    button {
      padding: 0 0.4rem;
      border: 0;
      color: inherit;
      background: transparent;
      font-size: 1.7rem;
      cursor: pointer;
    }
  }

  .mobile-toc-content {
    max-height: calc(min(70vh, 36rem) - 4rem);
    overflow: auto;
    -webkit-overflow-scrolling: touch;

    .tocbot-list {
      padding-left: 1rem;
    }

    .tocbot-link {
      display: block;
      padding: 0.32rem 0;
      color: inherit;
      overflow-wrap: anywhere;
    }
  }

  .mobile-toc-open {
    overflow: hidden;
  }
}

// 首页筛选与统一卡片视觉
.home-filter {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.55rem;
  max-width: 1080px;
  margin: 0 auto 1.5rem;
  padding: 0.8rem;
  border: 1px solid rgba(127, 127, 127, 0.14);
  border-radius: 1rem;
  background: var(--board-bg-color);
  box-shadow: 0 8px 24px rgba(31, 45, 61, 0.06);

  button {
    padding: 0.42rem 0.85rem;
    border: 0;
    border-radius: 999px;
    color: var(--text-color);
    background: var(--button-hover-bg-color);
    cursor: pointer;

    &.active {
      color: #fff;
      background: linear-gradient(135deg, #2f80ed, #8b5cf6);
    }

    small {
      margin-left: 0.2rem;
      opacity: 0.72;
      font-size: 0.7rem;
    }
  }
}

.home-filter-count {
  color: var(--text-color);
  font-size: 0.82rem;
}

.home-filter .home-excerpts-button {
  margin-left: auto;
  color: #6653d7;
  background: rgba(124, 92, 255, 0.09);

  &:hover { background: rgba(124, 92, 255, 0.16); }
}

.home-post-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem;
  max-width: 1080px;
  margin: 0 auto;
}

.index-card {
  width: 100%;
  max-width: none;
  margin: 0 !important;
  border: 1px solid rgba(127, 127, 127, 0.12);
  border-radius: 0.9rem;
  background: linear-gradient(145deg, var(--board-bg-color), rgba(248, 249, 252, 0.62));
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(31, 45, 61, 0.07);
  transition: transform 0.2s ease, box-shadow 0.2s ease;

  &:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 36px rgba(31, 45, 61, 0.12);
  }

  &[hidden] {
    display: none !important;
  }

  .index-img img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 0.8rem;
  }

  .post-meta a {
    display: inline-block;
    margin: 0.08rem 0.12rem;
    padding: 0.08rem 0.38rem;
    border-radius: 999px;
    background: var(--button-hover-bg-color);
  }

  .index-info {
    min-width: 0;
    padding: 1.05rem 1.15rem;
  }

  .index-header {
    margin-bottom: 0.2rem;
    font-size: 1.25rem;
  }

  .index-excerpt {
    height: calc(1.5rem * 2);
    margin: 0.35rem 0 0.7rem;

    > div {
      line-height: 1.5rem;
      -webkit-line-clamp: 2;
    }
  }

  .index-btm { font-size: 0.78rem; }
}

.home-pagination {
  display: flex;
  justify-content: center;
  gap: 0.45rem;
  max-width: 1080px;
  margin: 2rem auto 0.5rem;

  &[hidden] { display: none; }

  button {
    min-width: 2.45rem;
    height: 2.45rem;
    padding: 0 0.65rem;
    border: 1px solid rgba(127, 127, 127, 0.16);
    border-radius: 0.65rem;
    color: var(--text-color);
    background: var(--board-bg-color);
    cursor: pointer;

    &:hover:not(:disabled) { transform: translateY(-1px); border-color: #7c5cff; }
    &.active { color: #fff; border-color: transparent; background: linear-gradient(135deg, #2f80ed, #8b5cf6); }
    &:disabled { opacity: 0.35; cursor: default; }
  }
}

.index-card .index-excerpt,
.index-card .index-btm,
.index-card .post-meta a,
.index-card .category-chain-item {
  color: var(--text-color) !important;
}

// 学习路线、相关推荐与更新记录
.knowledge-series,
.related-posts,
.post-changelog {
  margin: 2rem 0;
  padding: 1.1rem 1.2rem;
  border: 1px solid rgba(127, 127, 127, 0.16);
  border-radius: 1rem;
  background: linear-gradient(145deg, var(--board-bg-color), var(--body-bg-color));
}

.series-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;

  small { color: var(--sec-text-color); }
  h2 { margin: 0.1rem 0 0; font-size: 1.15rem; }
}

.series-progress {
  height: 0.38rem;
  margin: 0.8rem 0 1rem;
  border-radius: 999px;
  background: var(--button-hover-bg-color);
  overflow: hidden;

  span { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #20d9d2, #8b5cf6, #ec4899); }
}

// 超宽屏文章布局：轻微拓宽正文，并用系列导航平衡左侧留白
.series-rail {
  display: none;
}

@media (min-width: 1400px) {
  .post-left-col {
    flex: 0 0 12.5%;
    max-width: 12.5%;
  }

  .post-main-col {
    flex: 0 0 70.833333%;
    max-width: 70.833333%;
  }

  .post-content {
    max-width: 1040px;
  }

  .post-right-col {
    flex: 0 0 16.666667%;
    max-width: 16.666667%;
  }

  .series-rail {
    position: sticky;
    top: 6.25rem;
    display: block;
    width: calc(100% - 2rem);
    max-width: 13.5rem;
    margin: 5rem auto 0;
    padding: 0.25rem 0.35rem;

    .series-rail-heading {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.6rem;

      a {
        min-width: 0;
        overflow: hidden;
        color: var(--text-color);
        font-size: 0.82rem;
        font-weight: 700;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      span {
        flex: 0 0 auto;
        color: var(--sec-text-color);
        font-size: 0.68rem;
        font-variant-numeric: tabular-nums;
      }
    }

    .series-progress {
      height: 0.22rem;
      margin: 0.55rem 0 1rem;
      background: rgba(127, 127, 127, 0.12);
    }

    nav {
      position: relative;
      margin-left: 0.35rem;
      padding-left: 1rem;

      &::before {
        content: '';
        position: absolute;
        top: 0.55rem;
        bottom: 0.55rem;
        left: 0.15rem;
        width: 2px;
        border-radius: 999px;
        background: linear-gradient(180deg, rgba(47,128,237,.3), #7c5cff, rgba(236,72,153,.3));
      }
    }

    nav a {
      position: relative;
      display: grid;
      grid-template-columns: 1.45rem minmax(0, 1fr);
      align-items: start;
      margin: 0;
      padding: 0.38rem 0.2rem 0.42rem;
      color: var(--text-color);
      line-height: 1.35;

      &::before {
        content: '';
        position: absolute;
        top: 0.58rem;
        left: -1.22rem;
        width: 0.52rem;
        height: 0.52rem;
        border: 2px solid var(--body-bg-color);
        border-radius: 50%;
        background: #aab3c2;
        box-shadow: 0 0 0 1px rgba(127,127,127,.2);
      }

      &:hover strong { color: #6d5ce7; }
      small { color: var(--sec-text-color); font-size: 0.62rem; font-variant-numeric: tabular-nums; }
      strong { display: -webkit-box; overflow: hidden; font-size: 0.76rem; font-weight: 500; transition: color .18s ease; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
    }

    nav .passed {
      &::before { background: #20a77a; }
      small { color: #208765; }
    }

    nav .current {
      &::before { background: #7c5cff; box-shadow: 0 0 0 3px rgba(124,92,255,.14); }
      small, strong { color: #6d5ce7; }
      strong { font-weight: 700; }
    }

    nav .upcoming { opacity: 0.72; }

    .series-rail-hint {
      margin: 0.75rem 0 0 1.35rem;
      color: var(--sec-text-color);
      font-size: 0.64rem;
      line-height: 1.5;
    }

    .series-rail-extra {
      margin: 0.9rem 0 0 1.35rem;
      padding-top: 0.8rem;
      border-top: 1px solid rgba(127,127,127,.13);

      p { margin: 0 0 0.4rem; color: var(--sec-text-color); font-size: 0.66rem; }
    }

    .series-rail-section { margin-bottom: 0.75rem; }

    .series-rail-section-head {
      display: flex;
      align-items: center;
      justify-content: space-between;

      button { padding: 0; border: 0; color: #6d5ce7; background: transparent; font-size: 0.6rem; cursor: pointer; }
    }

    .rail-review ul {
      margin: 0;
      padding: 0;
      list-style: none;

      li { margin: 0.22rem 0; }
      button { display: block; width: 100%; overflow: hidden; padding: 0; border: 0; color: var(--sec-text-color); background: transparent; font-size: 0.63rem; line-height: 1.4; text-align: left; text-overflow: ellipsis; white-space: nowrap; cursor: pointer; }
      button:hover { color: #6d5ce7; }
    }

    [data-article-terms] {
      display: flex;
      flex-wrap: wrap;
      gap: 0.28rem;

      button { padding: 0.12rem 0.32rem; border: 1px dashed rgba(124,92,255,.35); border-radius: 999px; color: #6d5ce7; background: transparent; font-size: 0.6rem; cursor: pointer; }
    }

    .series-rail-actions {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.18rem;

      button {
        padding: 0.18rem 0;
        border: 0;
        color: var(--sec-text-color);
        background: transparent;
        font-size: 0.66rem;
        cursor: pointer;

        &:hover, &.active { color: #6d5ce7; }
      }
    }

    .series-mastery {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.35rem;
      margin: 0.7rem 0 0.5rem;
      color: var(--sec-text-color);
      font-size: 0.65rem;

      select { min-width: 0; padding: 0.15rem 0.2rem; border: 1px solid rgba(127,127,127,.15); border-radius: 0.35rem; color: var(--text-color); background: var(--board-bg-color); font-size: 0.62rem; }
    }

    .series-rail-feedback {
      display: block;
      min-height: 1rem;
      margin-top: 0.2rem;
      color: #20a77a;
      font-size: 0.6rem;
    }
  }
}

.knowledge-local-dialog {
  width: calc(100vw - 2rem);
  max-width: 34rem;
  max-height: calc(100vh - 2rem);
  padding: 1.1rem;
  border: 1px solid rgba(127,127,127,.16);
  border-radius: 1rem;
  color: var(--text-color);
  background: var(--board-bg-color);
  box-shadow: 0 24px 70px rgba(20,24,35,.28);

  &::backdrop { background: rgba(20,24,35,.45); backdrop-filter: blur(2px); }
  > p { color: var(--sec-text-color); font-size: 0.8rem; }
  textarea { width: 100%; padding: 0.75rem; border: 1px solid rgba(127,127,127,.18); border-radius: 0.65rem; color: var(--text-color); background: var(--body-bg-color); line-height: 1.6; resize: vertical; }
}

.knowledge-dialog-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.8rem; }
.knowledge-dialog-head h3 { margin: 0; font-size: 1rem; }
.knowledge-dialog-head button { border: 0; color: var(--sec-text-color); background: transparent; font-size: 1.35rem; cursor: pointer; }
.knowledge-dialog-actions { display: flex; justify-content: flex-end; margin-top: 0.75rem; }
.knowledge-dialog-actions .primary { padding: 0.45rem 0.75rem; border: 0; border-radius: 0.5rem; color: #fff; background: #6d5ce7; cursor: pointer; }

.excerpt-capture-button {
  position: fixed;
  z-index: 1100;
  padding: 0.36rem 0.55rem;
  border: 0;
  border-radius: 0.5rem;
  color: #fff;
  background: #6d5ce7;
  box-shadow: 0 6px 18px rgba(59,48,130,.25);
  font-size: 0.72rem;
  cursor: pointer;
}

.excerpt-library-dialog { overflow-y: auto; }
.excerpt-library-empty { display: grid; gap: 0.3rem; padding: 2.2rem 1rem; color: var(--sec-text-color); text-align: center; }
.excerpt-library-empty strong { color: var(--text-color); font-size: 0.95rem; }
.excerpt-library-empty span { font-size: 0.78rem; }
.excerpt-library-group + .excerpt-library-group { margin-top: 1.1rem; padding-top: 1rem; border-top: 1px solid rgba(127,127,127,.13); }
.excerpt-library-title { display: inline-block; margin-bottom: 0.45rem; color: #6653d7; font-size: 0.84rem; font-weight: 600; }
.excerpt-library-group blockquote { margin: 0.45rem 0; padding: 0.65rem 0.75rem; border-left: 2px solid rgba(124,92,255,.55); border-radius: 0 0.5rem 0.5rem 0; background: var(--button-hover-bg-color); }
.excerpt-library-group blockquote p { margin: 0; font-size: 0.78rem; line-height: 1.65; }
.excerpt-library-group blockquote div { display: flex; justify-content: flex-end; gap: 0.7rem; margin-top: 0.35rem; }
.excerpt-library-group blockquote a,
.excerpt-library-group blockquote button { padding: 0; border: 0; color: var(--sec-text-color); background: transparent; font-size: 0.66rem; cursor: pointer; }
.excerpt-library-group blockquote button { color: #c44f65; }
.knowledge-series ol {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.45rem;
  margin: 0;
  padding: 0;
  list-style: none;

  a { display: flex; align-items: center; gap: 0.55rem; padding: 0.4rem; border-radius: 0.55rem; color: inherit; }
  a:hover, .current a { background: var(--button-hover-bg-color); }
  li span { display: grid; place-items: center; flex: 0 0 1.55rem; height: 1.55rem; border-radius: 50%; background: var(--button-hover-bg-color); font-size: 0.75rem; }
  .completed span { color: #fff; background: #20a77a; }
  .current span { color: #fff; background: #7c5cff; }
}

.related-posts h2 { margin-top: 0; font-size: 1.15rem; }
.related-post-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.55rem; }
.related-post-grid a { display: flex; flex-direction: column; padding: 0.7rem; border-radius: 0.65rem; color: inherit; background: var(--button-hover-bg-color); }
.related-post-grid small { margin-top: 0.25rem; color: var(--sec-text-color); }
.discovery-actions { display: flex; gap: 0.6rem; margin-top: 0.8rem; }
.discovery-actions button, .not-found-actions button, .not-found-actions a { padding: 0.48rem 0.8rem; border: 0; border-radius: 0.55rem; color: #fff; background: #3977d4; cursor: pointer; }
.post-changelog summary { cursor: pointer; font-weight: 600; }
.post-changelog ol { margin: 0.8rem 0 0; padding-left: 1.2rem; }
.post-changelog li { margin: 0.3rem 0; }
.post-changelog time { margin-right: 0.7rem; color: var(--sec-text-color); font-variant-numeric: tabular-nums; }

// 术语悬浮释义
.term-tip {
  position: relative;
  border-bottom: 1px dashed #7c5cff;
  text-decoration: none;
  cursor: help;

  &::after {
    content: attr(data-definition);
    position: absolute;
    z-index: 20;
    left: 50%;
    bottom: calc(100% + 0.5rem);
    width: max-content;
    max-width: min(18rem, 75vw);
    padding: 0.55rem 0.7rem;
    border-radius: 0.55rem;
    color: #fff;
    background: rgba(27, 31, 42, 0.96);
    font-size: 0.78rem;
    line-height: 1.5;
    opacity: 0;
    transform: translate(-50%, 0.3rem);
    visibility: hidden;
    pointer-events: none;
    transition: 0.18s ease;
  }

  &:hover::after, &:focus::after { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
}

// 数据看板
.insights-dashboard { max-width: 980px; margin: 0 auto; padding: 0.4rem 0 2rem; }
.insight-summary { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; }
.insight-summary article { position: relative; display: flex; flex-direction: column; min-height: 5.2rem; padding: 0.9rem 1rem; border: 1px solid rgba(127,127,127,.12); border-radius: 0.85rem; background: var(--board-bg-color); overflow: hidden; }
.insight-summary article::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 4px; background: linear-gradient(180deg, #2f80ed, #8b5cf6); }
.insight-summary article:nth-child(2)::before { background: linear-gradient(180deg, #20c9c3, #2f80ed); }
.insight-summary article:nth-child(3)::before { background: linear-gradient(180deg, #8b5cf6, #ec4899); }
.insight-summary article:nth-child(4)::before { background: linear-gradient(180deg, #ec4899, #ff8a3d); }
.insight-summary strong { font-size: 1.45rem; color: var(--text-color); line-height: 1.2; }
.insight-summary span { margin-top: auto; color: var(--sec-text-color); font-size: 0.75rem; }
.insight-panels { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(15rem, .65fr); align-items: start; gap: 0.85rem; margin-top: 0.85rem; }
.insight-panel { padding: 1rem 1.1rem; border: 1px solid rgba(127,127,127,.12); border-radius: 0.9rem; background: var(--board-bg-color); }
.insight-panel h2 { margin: 0 0 0.75rem; font-size: 1rem; }
.category-chart > div { display: grid; grid-template-columns: 5rem 1fr 2rem; align-items: center; gap: 0.55rem; margin: 0.65rem 0; }
.category-chart > div > div { height: 0.5rem; border-radius: 999px; background: var(--button-hover-bg-color); overflow: hidden; }
.category-chart i { display: block; height: 100%; background: linear-gradient(90deg, #20d9d2, #8b5cf6); }
.insight-recent { grid-column: 1 / -1; }
.insight-latest { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 1.25rem; }
.insight-latest a, .not-found-posts a { display: flex; justify-content: space-between; gap: 1rem; padding: 0.5rem 0; border-bottom: 1px solid rgba(127,127,127,.1); color: inherit; }
.insight-latest time, .not-found-posts time { color: var(--text-color); font-size: 0.8rem; }
.update-chart { display: flex; align-items: flex-end; gap: 0.6rem; min-height: 9rem; padding-top: 0.25rem; }
.update-chart > div { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: flex-end; height: 8rem; gap: 0.25rem; }
.update-chart i { order: 2; width: min(2.4rem, 70%); border-radius: 0.45rem 0.45rem 0.15rem 0.15rem; background: linear-gradient(180deg, #ec4899, #7c5cff); }
.update-chart i.empty { min-height: 3px; opacity: 0.35; }
.update-chart strong { order: 1; color: var(--sec-text-color); font-size: 0.7rem; }
.update-chart span { order: 3; color: var(--sec-text-color); font-size: 0.68rem; white-space: nowrap; }

// 404 恢复入口
.not-found-panel { max-width: 720px; margin: 2rem auto; padding: 1.5rem; border-radius: 1rem; background: var(--board-bg-color); text-align: center; }
.not-found-code { font-size: clamp(3rem, 12vw, 6rem); font-weight: 800; line-height: 1; color: transparent; background: linear-gradient(90deg, #2f80ed, #8b5cf6, #ec4899); background-clip: text; }
.not-found-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 0.6rem; margin: 1.2rem 0; }
.not-found-posts { margin-top: 1.2rem; text-align: left; }
.not-found-posts h2 { font-size: 1.05rem; }

.highlight .gutter .line { color: #414a56 !important; opacity: 1 !important; }
.markdown-body .hljs-keyword { color: #743c96; }
[data-user-color-scheme='dark'] .highlight .gutter .line { color: #bdc6d3 !important; }
[data-user-color-scheme='dark'] .markdown-body .hljs-keyword { color: #d4a5f5; }
[data-user-color-scheme='dark'] .index-card { background: var(--board-bg-color); }

@media (max-width: 767.98px) {
  .home-filter { margin: 0 0.6rem 1rem; }
  .home-filter-count { width: 100%; margin-left: 0; }
  .index-card { margin-left: 0.5rem !important; margin-right: 0.5rem !important; }
  .index-card .index-info { padding: 1rem 1.05rem; }
  .index-card .index-header { font-size: 1.22rem; }
  .home-post-grid { grid-template-columns: 1fr; margin: 0 0.5rem; }
  .knowledge-series ol, .related-post-grid, .insight-panels { grid-template-columns: 1fr; }
  .insight-summary { grid-template-columns: repeat(2, 1fr); }
  .insight-latest { grid-template-columns: 1fr; }
  .connect-grid { grid-template-columns: 1fr; }
}
