// 分类页
.category {
  .row {
    border-radius: 1rem;
  }

  .category-item {
    border-radius: 1rem;
  }

  .category-post-list {
    border-radius: 1rem;
  }
}

// 归档页
.list-group {
  border-radius: 1rem;
}

// 分类和归档页共同
.list-group-item {
  border-radius: 1rem;
}

// 友链页
.links .card-body {
  border-radius: 1rem;
}

// 菜单栏
.navbar {
  .nav-item .nav-link {
    border-radius: 0.5rem;
  }

  .dropdown-menu {
    border-radius: 0.5rem;
  }

  .dropdown-item {
    border-radius: 0.25rem;
  }
}

// 页面背景板
#board {
  border-radius: 1rem;
}

// 返回顶部按钮
#scroll-top-button {
  border-radius: 0.5rem;
}

// 文章目录长标题自动换行，避免省略号截断
#toc .toc-list-item {
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
  overflow-wrap: anywhere;
  word-break: break-word;
}

#toc .tocbot-link {
  display: block;
  padding-top: 0.12rem;
  padding-bottom: 0.12rem;
  line-height: 1.45;
}

// 阅读进度、剩余时间和文章分享
.reading-progress {
  position: fixed;
  z-index: 1040;
  top: 0;
  left: 0;
  width: 100%;
  height: 3px;
  pointer-events: none;

  > span {
    display: block;
    width: 0;
    height: 100%;
    background: linear-gradient(90deg, #29d, #7c5cff);
    box-shadow: 0 0 8px rgba(34, 153, 221, 0.55);
    transition: width 80ms linear;
  }
}

.reading-indicator {
  position: fixed;
  z-index: 1030;
  right: 1rem;
  bottom: 4.8rem;
  padding: 0.3rem 0.65rem;
  border-radius: 999px;
  color: #fff;
  background: rgba(32, 35, 42, 0.78);
  font-size: 0.75rem;
  opacity: 0;
  transform: translateY(6px);
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.2s ease;
  backdrop-filter: blur(8px);

  &.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
}

.article-share-button {
  position: fixed;
  z-index: 1030;
  right: 1rem;
  bottom: 7.25rem;
  width: 2.5rem;
  height: 2.5rem;
  padding: 0;
  border: 0;
  border-radius: 0.65rem;
  color: #fff;
  background: rgba(32, 35, 42, 0.78);
  font-size: 1.25rem;
  line-height: 2.5rem;
  cursor: pointer;
  backdrop-filter: blur(8px);
  transition: transform 0.18s ease, background 0.18s ease;

  &:hover,
  &:focus-visible {
    background: #29d;
    transform: translateY(-2px);
    outline: none;
  }
}

@media (max-width: 575.98px) {
  .reading-indicator {
    right: 0.65rem;
    bottom: 4.5rem;
  }

  .article-share-button {
    right: 0.65rem;
    bottom: 7rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .reading-progress > span,
  .reading-indicator,
  .article-share-button {
    transition: none;
  }
}

// 搜索键盘选择状态
#local-search-result .search-result-active {
  color: #fff;
  background: #29d;
  border-color: #29d;
}

// 移动端悬浮文章目录
.mobile-toc-button,
.mobile-toc-panel {
  display: none;
}

@media (max-width: 991.98px) {
  .mobile-toc-button {
    display: block;
    position: fixed;
    z-index: 1030;
    left: 0.65rem;
    bottom: 1rem;
    width: 2.65rem;
    height: 2.65rem;
    padding: 0;
    border: 0;
    border-radius: 0.65rem;
    color: #fff;
    background: rgba(32, 35, 42, 0.82);
    font-size: 1.2rem;
    cursor: pointer;
    backdrop-filter: blur(8px);
  }

  .mobile-toc-button[hidden] {
    display: none;
  }

  .mobile-toc-panel {
    display: flex;
    position: fixed;
    z-index: 1050;
    inset: 0;
    align-items: flex-end;
    padding: 1rem;
    background: rgba(0, 0, 0, 0.42);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .mobile-toc-panel.is-open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-toc-card {
    width: 100%;
    max-height: min(70vh, 36rem);
    padding: 1rem;
    border-radius: 1rem;
    background: var(--board-bg-color, #fff);
    box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.2);
    overflow: hidden;
    transform: translateY(1rem);
    transition: transform 0.2s ease;
  }

  .mobile-toc-panel.is-open .mobile-toc-card {
    transform: translateY(0);
  }

  .mobile-toc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;

    button {
      padding: 0 0.4rem;
      border: 0;
      color: inherit;
      background: transparent;
      font-size: 1.7rem;
      cursor: pointer;
    }
  }

  .mobile-toc-content {
    max-height: calc(min(70vh, 36rem) - 4rem);
    overflow: auto;
    -webkit-overflow-scrolling: touch;

    .tocbot-list {
      padding-left: 1rem;
    }

    .tocbot-link {
      display: block;
      padding: 0.32rem 0;
      color: inherit;
      overflow-wrap: anywhere;
    }
  }

  .mobile-toc-open {
    overflow: hidden;
  }
}
